# Flask Configuration
FLASK_ENV=development
FLASK_APP=run.py
PORT=5000
SECRET_KEY=eventhub-super-secret-key-change-in-prod

# Database Configuration
DATABASE_PATH=database/database.db

# Static / Uploads Configuration
UPLOAD_FOLDER=uploads/events
MAX_CONTENT_LENGTH=16777216  # 16 MB

# Admin Credentials
ADMIN_ID=ADMIN001
ADMIN_PASSWORD=EventHub@2026

# SMTP Email Configuration
# For Gmail: Use smtp.gmail.com with port 587 and a 16-character App Password (NOT your regular Google password).
# How to get App Password: Google Account -> Security -> 2-Step Verification -> App Passwords -> Create "EventHub"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL="EventHub College <no-reply@eventhub.college.edu>"
